{
  "expo": {
    "name": "Hoot Unfathomably",
    "slug": "hoot-unfathomably",
    "version": "0.4.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#000000",
    "primaryColor": "#7e0000",
    "scheme": "hoot-unfathomably",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "bundleIdentifier": "org.brokenlamp.hootunfathomably"
    },
    "android": {
      "versionCode": 18,
      "userInterfaceStyle": "automatic",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "org.brokenlamp.hootunfathomably"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-background-task",
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hoot Unfathomably to record a GPS path only while the route recorder is open.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-notifications",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
